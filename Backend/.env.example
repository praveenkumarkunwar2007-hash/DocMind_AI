# Generate a long random value for production; never commit your real .env file.
JWT_SECRET=replace-with-a-long-random-secret
# Set to your live Render static-site origin, with no trailing slash.
FRONTEND_ORIGINS=https://YOUR-FRONTEND.onrender.com
# Use a persistent Render PostgreSQL database URL in production.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# Must point to a reachable Ollama server, not localhost unless Ollama runs in this same environment.
OLLAMA_BASE_URL=https://YOUR-PRIVATE-OLLAMA-HOST
OLLAMA_MODEL=qwen2.5:1.5b
MAX_UPLOAD_MB=10
TOKEN_HOURS=24
# Optional but recommended to prevent open public signups. Share this code privately.
REGISTRATION_CODE=replace-with-a-separate-invitation-code
